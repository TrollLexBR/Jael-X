 A.character=A.character or read(me,"Character")
 if A.experimental then local ok,err=pcall(A.stepExperimental,now);if not ok then A.stopExperimental();note(err,false)end end
 if A.clickTP and now>=(A.clickWarmAt or 0)then
  A.clickWarmAt=now+(A.rayReady(A.rayStatus)and 1 or .04)
  local ok,status=pcall(function()return A.warmRayScene(body())end)
  if ok then A.clickScene=status else A.clickTP=false;note(status,false)end
 end
 if A.loopSpeed and not A.effects.fly and not A.effects.freecam and now>=(A.speedAt or 0)then A.speedAt=now+.25;local ok,err=pcall(localWrite,"WalkSpeed",A.loopSpeed,"speed");if not ok then A.loopSpeed=nil;note(err,false)end end
