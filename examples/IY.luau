  local f=A.follow;f.next=now+.2;local ok,err=pcall(function()
   local _,_,r=body(f.player);local _,_,mine=body();local point=position(r)
   if(point-position(mine)).Magnitude<5 then if A.routeOwned then me:StopSmoothRoute();A.routeOwned=nil end;return end
   if not f.point or(point-f.point).Magnitude>1 then me:SmoothRoute(r.CFrame*CFrame.new(3,0,0),f.speed);A.routeOwned=true;f.point=point end
  end)
  if not ok then A.follow=nil;if A.routeOwned then pcall(me.StopSmoothRoute,me);A.routeOwned=nil end;note(err,false)end
 end
 if A.pendingClick and not A.busy then local point=A.pendingClick;A.pendingClick=nil;if A.clickTP then A.busy=true;task.spawn(function()local ok,message=pcall(A.clickTeleport,point);note(message,ok);A.busy=false end)end end
