function A.execute(text,quiet)
 if not A.alive then return false,"Panel unloaded"end
 local ok,args=pcall(tokenize,text);if not ok then if not quiet then note(args,false)end;return false,args end
 local name=table.remove(args,1)or "";if name:sub(1,1)==settings.prefix then name=name:sub(2)end;name=string.lower(name)
 local seen={};local depth=0
 while A.aliases[name]do
  if seen[name]or depth>=5 then local err="Alias cycle or depth limit";if not quiet then note(err,false)end;return false,err end
  seen[name]=true;depth=depth+1;local success,extra=pcall(tokenize,A.aliases[name]);if not success then return false,extra end
  for _,arg in ipairs(args)do extra[#extra+1]=arg end;args=extra;name=string.lower(table.remove(args,1)or "")
 end
 local command=A.lookup[name];if not command then local err="Unknown command: "..name;if not quiet then note(err,false)end;return false,err end
 if A.experimental and (command.group=="Movement"or command.group=="Teleport"or command.group=="Camera"or command.group=="World")then A.stopExperimental()end
 local success,result=pcall(command.run,args);result=tostring(result or(success and "Done"or "Command failed"))
 if not success then result=command.name..": "..result end
 if success then A.history[#A.history+1]=text;if #A.history>50 then table.remove(A.history,1)end end
 A.tests[name]={success=success,message=result,time=os.time()};if not quiet then note(result,success)end;return success,result
end
