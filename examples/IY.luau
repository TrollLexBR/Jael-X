 A.alive=false;A.editing=false;pcall(input.set_text_focus,false)
 for _,connection in ipairs(A.connections)do pcall(connection.Disconnect,connection)end;A.connections={}
 if shared.PRISM_YIELD==A then shared.PRISM_YIELD=nil end
end
local function running()return A.alive and shared.PRISM_YIELD==A end
function A.step(now)
 if not running()then return end
