local function resolveJobs()
	local started=os.clock();local budget=16
	while budget>0 and #APP.jobs>0 and os.clock()-started<.004 do
		local job=APP.jobs[1];local node=job.queue[job.at]
		if not node or job.visited>=256 or not read(job.model,"Parent")then
			APP.pending[job.model]=nil;table.remove(APP.jobs,1)
		else
