				elseif (isa(o,"Model")or isa(o,"Folder"))and read(o,"Name")~="LootGroup"then job.queue[#job.queue+1]=o end
			end
			if not found and not job.queue[job.at]then found=job.fallback end
			if found then
				local e=job.meta;e.model=job.model;e.part=found;e.kind=job.kind
				APP.groups[job.kind][job.model]=e;if job.kind=="Zone"then APP.zones[job.model]=e end;APP.pending[job.model]=nil;table.remove(APP.jobs,1)
